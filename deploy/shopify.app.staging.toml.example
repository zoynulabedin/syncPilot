# Copy to shopify.app.staging.toml and fill in the distinct staging app and stable HTTPS origin.
client_id = "REPLACE_WITH_STAGING_CLIENT_ID"
name = "SyncPilot Staging"
application_url = "https://REPLACE_WITH_STAGING_DOMAIN"
embedded = false

[build]
automatically_update_urls_on_dev = false

[auth]
redirect_urls = ["https://REPLACE_WITH_STAGING_DOMAIN/auth/callback"]

[access_scopes]
scopes = "read_products,write_products,read_inventory,write_inventory,read_locations"

[webhooks]
api_version = "2026-10"

[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "/webhooks/app/uninstalled"

[[webhooks.subscriptions]]
topics = ["app/scopes_update"]
uri = "/webhooks/app/scopes_update"

[[webhooks.subscriptions]]
topics = ["products/create", "products/update", "products/delete"]
uri = "/webhooks/products/update"

[[webhooks.subscriptions]]
topics = ["inventory_levels/update"]
uri = "/webhooks/inventory/levels/update"

[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request", "customers/redact", "shop/redact"]
uri = "/webhooks/privacy"
