# Copy to .env locally. Never commit your real secrets.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app-domain.example
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations
DATABASE_URL=postgresql://syncpilot:REPLACE_ME@localhost:5432/syncpilot?schema=public
NODE_ENV=development
APP_ENV=development
POSTGRES_PORT=5432
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
# Generate once: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Keep the same key across web/worker and restore it alongside encrypted DB backups.
SESSION_ENCRYPTION_KEY=
# Separate from the session key; preserve both independently of encrypted backups.
BACKUP_ENCRYPTION_KEY=
SYNC_WRITE_ENABLED=false
INVENTORY_WRITE_ENABLED=false
LOG_LEVEL=info
# Optional operator-approved HTTPS alert endpoint. Owner opt-in is also required in Settings.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_HOSTS=
ALERT_WEBHOOK_TOKEN=

# Bounded automatic product sync also requires SYNC_WRITE_ENABLED=true and owner consent.
AUTOMATIC_SYNC_ENABLED=false
